{
  "name": "@workspace/vibefuel-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Vibefuel client core: API contract types, HTTP and mock adapters, delivery policy, ad validation, wallet validation and event batching.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate:api": "openapi-typescript api/openapi.yaml -o src/generated/openapi.d.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,mjs,mts,json,md,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
